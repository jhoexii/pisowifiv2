WIFI_INTERFACE=wlan0
WAN_INTERFACE=eth0
HOTSPOT_IP=10.10.0.1
HOTSPOT_NET=10.10.0.0/24
DHCP_START=10.10.0.50
DHCP_END=10.10.0.250

WIFI_SSID=PisoWiFi
WIFI_PASSWORD=change-me-12345
WIFI_CHANNEL=6

PORTAL_PORT=8080
APP_SECRET=change-this-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password

BRAND_NAME=PisoWiFi
CURRENCY=PHP
TZ=Asia/Manila

# Coin input using libgpiod chip/line numbering.
COIN_GPIO_CHIP=/dev/gpiochip0
COIN_GPIO_LINE=6
COIN_ACTIVE_HIGH=1
COIN_PULSE_MIN_MS=30
COIN_PULSE_MAX_MS=1000
COIN_DEBOUNCE_MS=80

# Example: 1 pulse = ₱1.
COIN_PULSES_PER_PESO=1
