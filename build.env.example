# Copy this file to build.env and edit it before building.
# Never commit build.env if it contains real passwords.
PISOWIFI_WIFI_INTERFACE=wlan0
PISOWIFI_WAN_INTERFACE=eth0
PISOWIFI_SSID=PisoWiFi
PISOWIFI_WIFI_PASSWORD=change-me-12345
PISOWIFI_ADMIN_PASSWORD=change-me-now
PISOWIFI_GPIO_CHIP=/dev/gpiochip0
PISOWIFI_GPIO_LINE=6
